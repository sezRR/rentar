{
  "ConnectionStrings": {
    "RentarDb": "Host=localhost;Port=5432;Database=rentar;Username=rentar;Password=rentar"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Maintenance": {
    "Enabled": false,
    "StartTime": "22:00:00",
    "EndTime": "23:00:00"
  },
  "TokenOptions": {
    "Audience": "rentar.sezertetik.dev",
    "Issuer": "rentar.sezertetik.dev",
    "AccessTokenExpiration": 10,
    "SecurityKey": "dev-only-change-me-rentar-jwt-signing-key-at-least-32-bytes"
  },
  "Paths": {
    "DefaultCarImagePath": "wwwroot/uploads"
  },
  "Messaging": {
    "Outbox": {
      "DeliverInBackground": true,
      "PollingInterval": "00:00:05",
      "BatchSize": 20,
      "MaxAttempts": 10,
      "MaxRetryDelay": "00:05:00"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*"
}
